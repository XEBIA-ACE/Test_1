# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=identity-auth-service

# ─── PostgreSQL ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_db
DB_USER=auth_user
DB_PASSWORD=changeme
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# ─── PgBouncer ──────────────────────────────────────────────────────────────────
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=6432

# ─── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# ─── JWT ────────────────────────────────────────────────────────────────────────
# RS256 keys — loaded from Vault in production; used directly in development
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRY=900        # 15 minutes in seconds
JWT_REFRESH_TOKEN_EXPIRY=2592000   # 30 days in seconds
JWT_ISSUER=identity-auth-service
JWT_AUDIENCE=platform-services

# ─── HashiCorp Vault ────────────────────────────────────────────────────────────
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root
VAULT_JWT_SECRET_PATH=secret/data/auth/jwt
VAULT_DB_SECRET_PATH=secret/data/auth/db
VAULT_ENABLED=false

# ─── Kafka ──────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=identity-auth-service
KAFKA_GROUP_ID=identity-auth-group
KAFKA_TOPIC_USER_EVENTS=user.events
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ─── OTP ────────────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=300                # 5 minutes
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3

# ─── Account Lockout ────────────────────────────────────────────────────────────
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_WINDOW_SECONDS=900         # 15 minutes
LOCKOUT_DURATION_SECONDS=1800      # 30 minutes

# ─── OAuth2 / OIDC ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/oauth/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/oauth/facebook/callback

# ─── OpenTelemetry ──────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=identity-auth-service
OTEL_ENABLED=false

# ─── Outbox Relay ───────────────────────────────────────────────────────────────
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=100
