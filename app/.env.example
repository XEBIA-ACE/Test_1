# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=product_db
DB_USER=product_user
DB_PASSWORD=changeme
DB_POOL_MIN=2
DB_POOL_MAX=10
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=6432

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_INDEX_PRODUCTS=products

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=300
REDIS_DB=0

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=product-service
KAFKA_GROUP_ID=product-service-group
KAFKA_TOPIC_CATALOG_UPDATED=catalog.updated

# Circuit Breaker
CB_TIMEOUT_MS=3000
CB_ERROR_THRESHOLD_PERCENTAGE=50
CB_RESET_TIMEOUT_MS=30000

# Observability
OTEL_SERVICE_NAME=product-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_PORT=9090

# Secrets (use Vault/AWS Secrets Manager in production)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
